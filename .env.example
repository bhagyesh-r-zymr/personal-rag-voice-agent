PORT=3000
NODE_ENV=development

# Google Gemini
GEMINI_API_KEY=
LIVE_MODEL=gemini-3.1-flash-live-preview
CHAT_MODEL=gemini-2.5-flash

# OpenAI-compatible embeddings model (as requested)
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1024

# Pinecone
PINECONE_API_KEY=
PINECONE_INDEX=company-handbook
PINECONE_NAMESPACE=default

# Session behavior
MAX_CONTEXT_CHUNKS=6
# Chunks scoring below this (cosine similarity) are ignored; if none remain the assistant refuses without calling Gemini
MIN_RELEVANCE_SCORE=0.25
HANDBOOK_ONLY=true

# Uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=25
EMBEDDING_BATCH_SIZE=64

# Login and roles (SQLite database for users and sessions)
DB_PATH=data/app.db
# First admin, created on startup if no admin exists yet
ADMIN_EMAIL=
ADMIN_PASSWORD=
SESSION_TTL_HOURS=168
# Send the session cookie only over HTTPS (defaults to true when NODE_ENV=production)
SECURE_COOKIES=
